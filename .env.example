# Copy to .env, fill in the password and chmod 600 .env.
# Use a host address reachable from the application container.
AX_DB_HOST=127.0.0.1
AX_DB_PORT=5432
AX_DB_NAME=wia_platform
AX_DB_USER=wia_platform_admin
AX_DB_PASSWORD=

# Docker 전용 내부 DB 연결. 호스트에서 실행하는 이관 도구는 위 AX_DB_HOST를 사용합니다.
AX_CONTAINER_DB_HOST=172.17.0.1
AX_CONTAINER_DB_PORT=15433
